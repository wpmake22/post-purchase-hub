# Everything here is development-only and must not reach the WP.org build.
#
# bin/build.php keeps the authoritative list in dev_excludes(); this file
# mirrors it for tooling that reads .distignore instead. DistIgnoreParityTest
# fails the suite if the two drift apart.
#
# composer.json is deliberately absent: the build ships a rewritten,
# per-edition copy of it rather than excluding it.
#
# assets/src, package.json and webpack.config.js are deliberately absent too:
# WP.org guideline 4 requires the source of every compiled asset, and the tools
# that build it, to be publicly available, so both now ship in the artifact.
/.git
/.github
/.claude
/.wordpress-org
/docs
/tests
/node_modules
/vendor/bin
.distignore
.editorconfig
.gitignore
.phpcs.cache
.phpunit.result.cache
.wp-env.json
.wp-env.hpos.json
.wp-env.override.json
.wp-env.ci.json
CLAUDE.md
SECURITY.md
eslint.config.cjs
composer.lock
package-lock.json
phpcs.xml.dist
phpstan.neon.dist
phpunit.xml.dist
phpunit-integration.xml.dist
