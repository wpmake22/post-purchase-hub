<?xml version="1.0"?>
<ruleset name="Post-Purchase Hub for WooCommerce">
	<description>Coding standards for Post-Purchase Hub for WooCommerce.</description>

	<!--
		Only what ships, plus the tests that cover it. The build scripts in bin/
		are procedural CLI tools that never enter either zip, so WPCS's global
		prefix, escaping and i18n rules do not apply to them.

		PHPCS errors on a path that does not exist, so these cannot be declared
		ahead of the milestone that creates them: M01A must add free/ and pro/
		here.
	-->
	<file>post-purchase-hub.php</file>
	<file>uninstall.php</file>
	<file>src</file>
	<file>templates</file>
	<file>tests</file>

	<arg name="basepath" value="."/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>
	<arg name="cache" value=".phpcs.cache"/>
	<arg value="ps"/>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/assets/build/*</exclude-pattern>
	<exclude-pattern>/languages/*</exclude-pattern>

	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="WooCommerce-Core"/>

	<!-- PHPCS cannot verify the version guard in the main file, so the floor is asserted here too. -->
	<config name="minimum_wp_version" value="6.5"/>
	<config name="testVersion" value="8.1-"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="post-purchase-hub"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="pph_"/>
				<element value="PostPurchaseHub"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.Files.FileName">
		<!-- PSR-4 class files are StudlyCaps by design; the hyphenated-lowercase rule applies to the rest. -->
		<exclude-pattern>/src/*</exclude-pattern>
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<rule ref="WordPress.WP.GlobalVariablesOverride">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!-- Test bootstraps are CLI-only diagnostics; there is no HTML context to escape into. -->
	<rule ref="WordPress.Security.EscapeOutput">
		<exclude-pattern>/tests/bootstrap-*.php</exclude-pattern>
	</rule>
</ruleset>
