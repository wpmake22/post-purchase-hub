<?xml version="1.0"?>
<ruleset name="WPMake Post-Purchase Hub for WooCommerce">
	<description>Coding standards for WPMake Post-Purchase Hub for WooCommerce.</description>

	<!--
		Only what ships, plus the tests that cover it. The build scripts in bin/
		are procedural CLI tools that never enter either zip, so WPCS's global
		prefix, escaping and i18n rules do not apply to them.

		Both edition directories ship too, so both are checked here.
	-->
	<file>wpmake-post-purchase-hub.php</file>
	<file>uninstall.php</file>
	<file>src</file>
	<file>free</file>
	<file>pro</file>
	<file>templates</file>
	<file>tests</file>

	<arg name="basepath" value="."/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>
	<arg name="cache" value=".phpcs.cache"/>
	<arg value="ps"/>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/assets/build/*</exclude-pattern>
	<exclude-pattern>/languages/*</exclude-pattern>

	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="WooCommerce-Core"/>

	<!--
		M15: the security and database sniffs are errors, not warnings.

		WPCS ships several of these at warning severity because it cannot tell
		a real hole from a false positive — NonceVerification on any superglobal
		read, PreparedSQL on any interpolated identifier. A warning is a thing
		a build stays green with, and this plugin's whole risk surface is order
		data reached over unauthenticated routes. Every one of them is now a
		build failure, so silencing one has to be a deliberate `phpcs:ignore`
		with a reason on the line, which review can see.
	-->
	<rule ref="WordPress.Security">
		<type>error</type>
		<severity>5</severity>
	</rule>

	<rule ref="WordPress.DB">
		<type>error</type>
		<severity>5</severity>
	</rule>

	<!-- PHPCS cannot verify the version guard in the main file, so the floor is asserted here too. -->
	<config name="minimum_wp_version" value="6.5"/>
	<config name="testVersion" value="8.1-"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="wpmake-post-purchase-hub"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="wpmphub_"/>
				<element value="PostPurchaseHub"/>
			</property>
		</properties>
		<!-- Email templates fire WooCommerce's own documented hooks (header,
		     order-details, footer) to inherit its rendering. Those are core's
		     hook names to own, not ours to prefix. -->
		<exclude-pattern>/templates/emails/*</exclude-pattern>
	</rule>

	<rule ref="WordPress.Files.FileName">
		<!-- PSR-4 class files are StudlyCaps by design; the hyphenated-lowercase rule applies to the rest. -->
		<exclude-pattern>/src/*</exclude-pattern>
		<exclude-pattern>/free/src/*</exclude-pattern>
		<exclude-pattern>/pro/src/*</exclude-pattern>
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<rule ref="WordPress.WP.GlobalVariablesOverride">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<rule ref="WooCommerce.Commenting.CommentHooks">
		<!-- Tests invoke existing hooks to exercise them; they declare none, so there is nothing to document. -->
		<exclude-pattern>/tests/*</exclude-pattern>
		<!-- Email templates invoke WooCommerce's own header/order-details/footer
		     hooks to inherit its rendering — not new hooks of ours to document. -->
		<exclude-pattern>/templates/emails/*</exclude-pattern>
	</rule>

	<!-- Test bootstraps are CLI-only diagnostics; there is no HTML context to escape into. -->
	<rule ref="WordPress.Security.EscapeOutput">
		<exclude-pattern>/tests/bootstrap-*.php</exclude-pattern>
	</rule>
</ruleset>
