parameters:
	# Raised from 6 at M15. Level 7 (union-member access) caught four real
	# defects rather than needing annotations to satisfy; level 8 would need
	# null-guards on WordPress functions whose stubs say `false` for states
	# this plugin has already excluded, so it stops here.
	level: 7
	phpVersion: 80100
	paths:
		- src
		- free
		- pro
		- post-purchase-hub.php
	scanFiles:
		- vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
		- vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
		- vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
		- tests/stubs/wp-constants.php
		- tests/stubs/invoice-plugins.php
		- tests/stubs/tracking-ast.php
		- tests/stubs/tracking-shipment-tracking.php
		- tests/stubs/tracking-shipment-tracking-actions.php
	treatPhpDocTypesAsCertain: false
	# bin/build.php rewrites this constant when it stages each zip, so its value
	# in source is not its value in either distribution. Without this, PHPStan
	# folds it to the literal and calls the Pro branch unreachable.
	dynamicConstantNames:
		- PPH_EDITION
